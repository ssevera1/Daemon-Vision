<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Daemon Vision Companion — Dark Theme                -->
    <!-- ════════════════════════════════════════════════════ -->

    <style name="Theme.DaemonVision" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color: cyan -->
        <item name="colorPrimary">#00E5CC</item>
        <item name="colorPrimaryDark">#008877</item>
        <item name="colorPrimaryVariant">#00B8A3</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">#00E5CC</item>
        <item name="colorSecondaryVariant">#00B8A3</item>

        <!-- Accent / on-primary -->
        <item name="colorAccent">#00E5CC</item>
        <item name="colorOnPrimary">#0A0A14</item>
        <item name="colorOnSecondary">#0A0A14</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">#0A0A14</item>
        <item name="colorSurface">#0F1020</item>
        <item name="colorOnSurface">#CCDDEE</item>
        <item name="colorOnBackground">#CCDDEE</item>

        <!-- Error -->
        <item name="colorError">#FF3355</item>
        <item name="colorOnError">#FFFFFF</item>

        <!-- System bars -->
        <item name="android:statusBarColor">#0A0A14</item>
        <item name="android:navigationBarColor">#0A0A14</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Window -->
        <item name="android:windowBackground">#0A0A14</item>
        <item name="android:windowFullscreen">false</item>

        <!-- Text appearances -->
        <item name="android:textColorPrimary">#CCDDEE</item>
        <item name="android:textColorSecondary">#778899</item>
        <item name="android:textColorHint">#334455</item>

        <!-- EditText cursor and highlight -->
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:colorControlActivated">#00E5CC</item>
        <item name="android:colorControlHighlight">#2200E5CC</item>
        <item name="android:colorControlNormal">#334455</item>
    </style>

    <!-- ── Text Styles ── -->

    <style name="DaemonVision.Text.Title">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#00E5CC</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.3</item>
    </style>

    <style name="DaemonVision.Text.Subtitle">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#667788</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.5</item>
    </style>

    <style name="DaemonVision.Text.SectionHeader">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#556677</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.15</item>
    </style>

    <style name="DaemonVision.Text.Value">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#CCDDEE</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="DaemonVision.Text.Label">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#556677</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DaemonVision.Text.StatusConnected">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#00E5CC</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="DaemonVision.Text.StatusDisconnected">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#FF3355</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- ── Button Styles ── -->

    <style name="DaemonVision.Button.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#0A0A14</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="DaemonVision.Button.Outline">
        <item name="android:background">@drawable/button_outline</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#00E5CC</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="DaemonVision.Button.Danger">
        <item name="android:background">@drawable/button_danger</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#CCDDEE</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- ── Card Style ── -->

    <style name="DaemonVision.Card">
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- ── Input Style ── -->

    <style name="DaemonVision.Input">
        <item name="android:background">@drawable/input_background</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#CCDDEE</item>
        <item name="android:textColorHint">#334455</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

</resources>
