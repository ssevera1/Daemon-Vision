<Project Sdk="Microsoft.NET.Sdk">

  <!-- Roslyn parse-only pass over the Unity C# sources. It catches syntax
       errors and language-version slips on every push without a Unity
       licence. It does not resolve types, so semantic errors still need the
       Unity EditMode job in unity-ci.yml. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

</Project>
